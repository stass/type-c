; Code that an interface must refuse: every .ml here is a test that
; misuse.sh checks, so a new file needs no rule. The include path is
; the directories of the interface files below.

(rule
 (alias runtest)
 (deps
  misuse.sh
  (:tests
   (glob_files *.ml))
  (:cmis
   (glob_files %{workspace_root}/src/cpp/.typec_cpp.objs/byte/*.cmi)
   (glob_files %{workspace_root}/src/syntax/.typec_syntax.objs/byte/*.cmi)))
 (action
  (setenv
   MISUSE_CMIS
   "%{cmis}"
   (run sh misuse.sh %{ocamlc} %{tests}))))
