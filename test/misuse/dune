; Code that an interface must refuse. A rule passes only when ocamlc
; rejects its file (exit code 2) and names the abstract type that the
; file misuses; the files are never built otherwise.

(rule
 (alias runtest)
 (deps
  identifier_bytes.ml
  (glob_files %{workspace_root}/src/cpp/.typec_cpp.objs/byte/*.cmi))
 (action
  (progn
   (with-outputs-to
    identifier_bytes.errors
    (with-accepted-exit-codes
     2
     (run
      %{ocamlc}
      -stop-after
      typing
      -I
      %{workspace_root}/src/cpp/.typec_cpp.objs/byte
      -open
      Typec_cpp
      -c
      identifier_bytes.ml)))
   (run grep -q "has type Typec_cpp.Reader.text" identifier_bytes.errors))))
