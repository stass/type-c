; Golden tests: source in, C or diagnostics out. Each cram test writes
; preprocessed text and shows what golden.exe makes of it.

(executable
 (name golden)
 (modules golden)
 (libraries typec_cpp typec_emit typec_driver typec_test_support))

(cram
 (deps golden.exe))

; Every rule has a negative golden case: some cram test shows its name.

(test
 (name coverage)
 (modules coverage)
 (libraries typec_syntax typec_test_support)
 (deps
  (glob_files *.t))
 (action
  (run %{test} %{deps})))

; No expected output, of a golden or a run test, cites the design: a
; diagnostic's reference is its rule name.

(test
 (name citations)
 (modules citations)
 (libraries typec_test_support)
 (deps
  (glob_files *.t)
  (glob_files_rec ../run/*.t))
 (action
  (run %{test} %{deps})))
