; The cram tests run the installed name, as a makefile would, and the
; backends that backends.sh names.

(cram
 (deps
  %{bin:typec}
  backends.sh
  (env_var TYPEC_TEST_CLANG)
  (env_var TYPEC_TEST_GCC)))

; The cram tests cannot print a note without changing their output, so
; this rule reports a target that backends.sh dropped, and fails when the
; host declared that it has it. The universe dependency makes every run
; report, not only the first of unchanged inputs.

(rule
 (alias runtest)
 (deps
  backends.sh
  (universe))
 (action
  (run sh -c ". ./backends.sh && backends_report")))

; version.t compares the output of --version with the release that
; dune-project names.

(cram
 (applies_to version)
 (deps %{project_root}/dune-project))

; read.t runs the reader on the output of both backends.

(executable
 (name read_check)
 (libraries typec_cpp typec_test_support))

(cram
 (applies_to read)
 (deps read_check.exe))

; types.t compiles the output of type_probe with each backend.

(executable
 (name type_probe)
 (libraries typec_sema typec_driver))

(cram
 (applies_to types)
 (deps type_probe.exe))

; packing.t compiles the output of pack_probe with each backend.

(executable
 (name pack_probe)
 (libraries typec_cpp typec_emit typec_test_support))

(cram
 (applies_to packing)
 (deps pack_probe.exe))

; parse.t and headers.t run the parser on the output of both backends.

(executable
 (name parse_check)
 (libraries typec_cpp typec_syntax typec_sema typec_test_support))

(cram
 (applies_to parse headers)
 (deps parse_check.exe))

; declarations.t compiles the output of declaration_probe with each
; backend.

(executable
 (name declaration_probe)
 (libraries typec_cpp typec_syntax typec_sema))

(cram
 (applies_to declarations)
 (deps declaration_probe.exe))

; expressions.t and initialisers.t compile the output of expression_probe
; with each backend; expressions.t also on the calls of the builtins that
; builtin_probe writes from the table.

(executable
 (name expression_probe)
 (libraries typec_cpp typec_syntax typec_sema))

(executable
 (name builtin_probe)
 (libraries typec_sema))

(cram
 (applies_to expressions initialisers)
 (deps expression_probe.exe))

(cram
 (applies_to expressions)
 (deps builtin_probe.exe))

; moved_lines.t compiles the output of moved_probe with each backend.

(executable
 (name moved_probe)
 (libraries typec_cpp typec_syntax typec_emit typec_test_support))

(cram
 (applies_to moved_lines)
 (deps moved_probe.exe))

; moved_pragmas.t compiles the output of moved_pragma_probe with each
; backend.

(executable
 (name moved_pragma_probe)
 (libraries typec_cpp typec_syntax typec_emit typec_test_support))

(cram
 (applies_to moved_pragmas)
 (deps moved_pragma_probe.exe))

; readme.t checks the examples of README.md with readme.sh.

(cram
 (applies_to readme)
 (deps readme.sh ../../README.md))

; tutorial.t and reference.t check the examples of docs/tutorial.md and
; docs/reference.md the same way.

(cram
 (applies_to tutorial)
 (deps readme.sh ../../docs/tutorial.md))

(cram
 (applies_to reference)
 (deps readme.sh ../../docs/reference.md))

; make_rule.t, ninja_rule.t and cmake_rule.t build with the rules that
; README.md shows, each where the host has its build tool.

(cram
 (applies_to make_rule ninja_rule cmake_rule)
 (deps calc_example.sh readme.sh ../../README.md))

(cram
 (applies_to make_rule)
 (enabled_if %{bin-available:make}))

(cram
 (applies_to ninja_rule)
 (enabled_if %{bin-available:ninja}))

; examples.t builds and checks each program of examples/ with its
; Makefile.

(cram
 (applies_to examples)
 (deps
  (source_tree ../../examples))
 (enabled_if %{bin-available:make}))

(cram
 (applies_to cmake_rule)
 (enabled_if
  (and %{bin-available:cmake} %{bin-available:ninja})))

; short_enums.t also runs the arm-none-eabi-gcc that TYPEC_TEST_ARM_GCC
; names, where present.

(cram
 (applies_to short_enums)
 (deps
  (env_var TYPEC_TEST_ARM_GCC)))
