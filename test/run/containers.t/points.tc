/*
 * Walks a path of points: the points in a vector(struct point), their
 * distances from the origin in a vector(double), and an index from each
 * point's step number to the point, allocated in a region, in a
 * map(int, struct point *).
 */

#include <math.h>
#include <stdio.h>

#include "demo.tci"

static struct point
step(int i)
{
	struct point p;

	p.x = i % 7 - 3;
	p.y = i * 2 - 5;
	return (p);
}

static double
distance(struct point p)
{

	return (sqrt((double)p.x * p.x + (double)p.y * p.y));
}

/* The steps looked up in the index, which holds every third. */
static const int probe_steps[] = { 0, 1, 3, 500, 501, 999, 1000 };

/* The index of every third point. */
static result(void, container_error)
index_points(map(int, struct point *) *index, region *r,
    slice(struct point) path)
{
	struct point *copy;
	size_t i;

	for (i = 0; i < path.len; i += 3) {
		copy = region_new(struct point)(r);
		if (copy == NULL)
			return (Err(OutOfMemory));
		*copy = path[i];
		try map_put(index, (int)i, copy);
	}
	return (Ok);
}

result(void, container_error)
walk_points(int n)
{
	vector(struct point) path;
	vector(double) distances;
	map(int, struct point *) index;
	region r;
	slice(const int) probes;
	double total;
	size_t j;
	int i;

	vector_init(&path);
	defer vector_free(&path);
	vector_init(&distances);
	defer vector_free(&distances);
	map_init(&index, hash_int, equal_int);
	defer map_free(&index);
	region_init(&r, 4096);
	defer region_release(&r);

	for (i = 0; i < n; i++) {
		try vector_push(&path, step(i));
		try vector_push(&distances, distance(step(i)));
	}
	try index_points(&index, &r, vector_items(&path));

	total = 0;
	while (distances.length > 0) {
		match (vector_pop(&distances)) {
		case Some(d):
			total += d;
			break;
		case None:
			break;
		}
	}
	printf("points %zu, total distance %.3f\n", path.length, total);
	probes = slice_from_array(probe_steps);
	for (j = 0; j < probes.len; j++) {
		match (map_get(&index, probes[j])) {
		case Some(p):
			printf("index %d: (%d, %d)\n", probes[j], p->x, p->y);
			break;
		case None:
			printf("index %d: none\n", probes[j]);
			break;
		}
	}
	printf("indexed %zu\n", index.count);
	return (Ok);
}
