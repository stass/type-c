typec --emit-c-header writes the C header of an interface (design 9.3):
the redirect to the interface under __TYPEC__, its guard, the macro
probe, and the lowered text of the interface in runs between its include
lines, each in a macro bracket. A C client compiles it on both backends,
with a command line and macros of its own that name what the header
uses.

  $ . ./backends.sh

The plain header defines CAPACITY one way as an enumerator and another
as a macro, so the lowered text of the field is "(CAPACITY + 1)", which
is 9 bytes to the Type-C units and would be 10 to a client that expanded
it again.

  $ cat > cap.h <<'EOF'
  > #ifndef CAP_H
  > #define CAP_H
  > enum { CAPACITY = 8 };
  > #define CAPACITY (CAPACITY + 1)
  > #endif
  > EOF
  $ cat > base.tci <<'EOF'
  > #ifndef BASE_TCI
  > #define BASE_TCI
  > typedef unsigned base_count;
  > #endif
  > EOF
  $ cat > room.tci <<'EOF'
  > #ifndef ROOM_TCI
  > #define ROOM_TCI
  > #include "cap.h"
  > #include "base.tci"
  > struct room { char bytes[CAPACITY]; };
  > type shape =
  >     | Circle(int r)
  >     | Square(int s);
  > base_count area(shape *s);
  > static const char *const room_mark = "(???=)";
  > #endif
  > EOF

Each interface gets its header beside it, the one that room.tci includes
too. The literal holds a trigraph sequence, of which the backends warn.

  $ export TYPEC_CC="$clang"
  $ typec --emit-c-header base.tci
  $ typec -Wno-trigraphs --emit-c-header room.tci
  $ head -1 room.h
  /* Generated by typec --emit-c-header. Do not edit. */
  $ grep -v '^#pragma\|^#undef' room.h
  /* Generated by typec --emit-c-header. Do not edit. */
  #ifdef __TYPEC__
  #include "room.tci"
  #else
  #ifndef __tc_module__room
  #define __tc_module__room
  #define __tc_macro_probe__room 1
  #ifndef __tc_macro_probe__room
  #error "this header needs #pragma push_macro and pop_macro"
  #endif
  _Static_assert(__tc_macro_probe__room, "needs push_macro and pop_macro");
  #include "cap.h"
  #include "base.h"
  struct room { char bytes [ ( CAPACITY + 1 ) ] ; } ;
  struct shape ; typedef struct shape shape ; enum shape_tag { shape_Circle , shape_Square } ; struct shape { enum shape_tag tag ; union {
  struct { int r ; } Circle ;
  struct { int s ; } Square ; } u ; } ;
  base_count area ( shape * s ) ;
  static const char * const room_mark = "(?\?\?=)" ;
  #endif
  #endif

The client defines names that the header uses on its command line and in
its text, and finds each of them again after the header; a name that the
header uses and the client did not define stays undefined. Under
-trigraphs the literal reads as the interface wrote it.

  $ cat > client.c <<'EOF'
  > #include <stdio.h>
  > #include <string.h>
  > #define s 5
  > #include "room.h"
  > #include "room.h"
  > _Static_assert(sizeof(struct room) == 9, "the client's layout");
  > _Static_assert(s == 5, "a macro of the client after the header");
  > _Static_assert(tag == 3, "a macro of the command line");
  > #ifdef shape_Circle
  > #error "a name of the header is a macro after it"
  > #endif
  > #ifndef r
  > #error "r is no macro after the header"
  > #endif
  > base_count area(shape *shape_) { return shape_->u.Circle.r; }
  > int main(void) {
  >   shape c = { shape_Circle, { { 2 } } };
  >   const char mark[] = { '(', '?', '?', '?', '=', ')', 0 };
  >   printf("%u %d\n", area(&c), strcmp(room_mark, mark) == 0);
  >   return 0;
  > }
  > EOF
  $ strict="-pedantic-errors -Wall -Wextra -Werror"
  $ for cc in "$clang" "$gcc"; do
  >   for std in c11 gnu17; do
  >     "$cc" -std=$std $strict -Dtag=3 -Dr=r -Dbytes=7 \
  >       client.c -o client && ./client || echo "failed: $cc $std"
  >   done
  >   "$cc" -std=c11 -trigraphs -Wno-trigraphs $strict -Dtag=3 -Dr=r \
  >     client.c -o client && ./client || echo "failed: $cc trigraphs"
  > done
  2 1
  2 1
  2 1
  2 1
  2 1
  2 1

A Type-C unit that includes the header reads the interface itself.

  $ cat > unit.tc <<'EOF'
  > #include "room.h"
  > base_count twice(shape *s);
  > base_count area(shape *s) {
  >   return twice(s);
  > }
  > EOF
  $ typec -Wno-trigraphs -fsyntax-only unit.tc

Under -o the header goes where it names, and -o - is stdout.

  $ typec -Wno-trigraphs --emit-c-header room.tci -o elsewhere.h
  $ cmp elsewhere.h room.h
  $ typec -Wno-trigraphs --emit-c-header room.tci -o - | cmp - room.h

A header that typec did not write stays as it is, and so does anything
that is not a regular file; one that typec wrote is replaced.

  $ echo '/* mine */' > hand.h
  $ typec -Wno-trigraphs --emit-c-header room.tci -o hand.h
  typec: hand.h is not a header that typec wrote, and typec does not write over it: name another path with -o
  [81]
  $ cat hand.h
  /* mine */
  $ ln -s room.h link.h
  $ typec -Wno-trigraphs --emit-c-header room.tci -o link.h
  typec: link.h is not a header that typec wrote, and typec does not write over it: name another path with -o
  [81]
  $ mkdir directory.h
  $ typec -Wno-trigraphs --emit-c-header room.tci -o directory.h
  typec: directory.h is not a header that typec wrote, and typec does not write over it: name another path with -o
  [81]
  $ chmod 640 room.h
  $ typec -Wno-trigraphs --emit-c-header room.tci
  $ ls -l room.h | cut -c1-10
  -rw-r-----
  $ (umask 026 && typec -Wno-trigraphs --emit-c-header room.tci -o masked.h)
  $ ls -l masked.h | cut -c1-10
  -rw-r-----
  $ ls -a | grep '\.tmp$'
  [1]

The refusals of the command line.

  $ typec -Wno-trigraphs --emit-c-header room.tci base.tci
  typec: --emit-c-header needs exactly one input, a .tci file
  [81]
  $ typec --emit-c-header unit.tc
  typec: --emit-c-header needs exactly one input, a .tci file
  [81]
  $ typec --emit-c-header -c room.tci
  typec: --emit-c-header cannot be used with -c, -S or -fsyntax-only: it writes a header and compiles nothing
  [81]
  $ typec --emit-c-header --emit-c room.tci
  typec: --emit-c cannot be used with --emit-c-header: one writes the C of a .tc unit, the other the header of a .tci interface
  [81]
  $ typec --emit-c-header -MD room.tci
  typec: --emit-c-header cannot be used with a dependency option (-M, -MM, -MD, -MMD, -MF, -MT, -MQ, -MP, -MG, -MV)
  [81]
  $ cp room.tci 'my room.tci'
  $ typec --emit-c-header 'my room.tci'
  typec: my room.tci cannot have a header: the last component of its path may hold only ASCII letters, digits, '.', '_', '-' and '+', since the header names it in an #include
  [81]

The refusals of the interface.

  $ for cc in "$clang" "$gcc"; do
  >   typec --cc="$cc" -Wno-trigraphs --emit-c-header -DROOM_TCI room.tci
  > done
  room.tci:1: error: the interface holds no token and no directive line in the output of -E: it has no #ifndef guard of its own, which an interface that has a header needs, or something defined that guard before the interface was read, as a file that -include names does when it includes the interface or defines its guard
  room.tci:1: error: the interface holds no token and no directive line in the output of -E: it has no #ifndef guard of its own, which an interface that has a header needs, or something defined that guard before the interface was read, as a file that -include names does when it includes the interface or defines its guard
  [80]
  $ printf 'int a;\n' > fields.h
  $ printf 'struct t {\n#include "fields.h"\n};\n' > inside.tci
  $ typec --emit-c-header inside.tci
  inside.tci:2: error: #include "fields.h" inside a declaration of an interface whose header is written: the header would hold the declaration without the text that the line brings
  [80]
  $ printf '#include_next <stddef.h>\n' > next.tci
  $ typec --emit-c-header next.tci
  next.tci:1:2: warning: #include_next in primary source file; will search from start of include path [-Winclude-next-outside-header]
      1 | #include_next <stddef.h>
        |  ^
  1 warning generated.
  next.tci:1: error: #include_next in an interface whose header is written: a C client would search on from the place of the header, not from that of the interface
  [80]
  $ printf '#ident "x"\nint a;\n' > ident.tci
  $ typec --cc="$gcc" --emit-c-header ident.tci
  ident.tci:1: error: #ident in an interface whose header is written: the header carries no directive of the interface but its include lines and pragmas
  [80]
  $ printf 'int caf\\u00e9;\n' > accent.tci
  $ typec --emit-c-header accent.tci
  accent.tci:1: error: identifier 'caf\u00E9' with a character outside the basic character set in an interface whose header is written: #pragma push_macro and pop_macro restore no macro of it in every C client
  [80]
  $ printf '#pragma weak x??=\nint a;\n' > tri.tci
  $ typec --cc="$gcc" -Wno-trigraphs --emit-c-header tri.tci
  tri.tci:1: error: trigraph sequence in '#pragma weak x??=', which a C client compiled with trigraphs would replace
  [80]

A #line that names another file, as a generated interface writes, leaves
the text of the interface where it is: its include lines and its
declarations reach the header alike.

  $ printf '#line 1 "gen.y"\n#ifndef GEN_TCI\n#define GEN_TCI\n' > gen.tci
  $ printf 'int a;\n#include <stddef.h>\nsize_t b;\n#endif\n' >> gen.tci
  $ for cc in "$clang" "$gcc"; do
  >   typec --cc="$cc" --emit-c-header gen.tci -o - |
  >     grep -x 'int a ;\|#include <stddef.h>\|size_t b ;'
  > done
  int a ;
  #include <stddef.h>
  size_t b ;
  int a ;
  #include <stddef.h>
  size_t b ;

Two headers that name one instance each write its declaration and its
definition, the definition under the instance's guard and the probe of
the packing brackets under names of the header, so a client includes
them together, in either order and twice. A client's macros of the
names of the instances and of the typedef of their argument do not reach
the text, and the client finds the layout that a Type-C unit finds.

  $ cat > vec.tci <<'EOF'
  > #ifndef VEC_TCI
  > #define VEC_TCI
  > type vec(T) = struct { T *data; int len; int cap; };
  > type link(T) = struct { link(T) *next; T v; };
  > #endif
  > EOF
  $ cat > left.tci <<'EOF'
  > #ifndef LEFT_TCI
  > #define LEFT_TCI
  > #include "vec.tci"
  > struct left { vec(int) v; char tag; };
  > void left_take(link(int) *l);
  > #endif
  > EOF
  $ cat > right.tci <<'EOF'
  > #ifndef RIGHT_TCI
  > #define RIGHT_TCI
  > #include "vec.tci"
  > struct right { char tag; vec(int) v; };
  > void right_take(link(int) *l);
  > #endif
  > EOF
  $ for name in vec left right; do typec --emit-c-header $name.tci; done
  $ grep '__tc_instance__\|__tc_pack_probe_.*{' left.h
  #ifndef __tc_instance__vec__i
  #define __tc_instance__vec__i
  struct __tc_pack_probe_1__left { char c ; int i ; } ;
  struct __tc_pack_probe_2__left { char c ; int i ; } ;
  $ cat > layout.tc <<'EOF'
  > #include <stddef.h>
  > #include "left.h"
  > #include "right.h"
  > const size_t layout[] = {
  >   sizeof(vec(int)), offsetof(vec(int), cap),
  >   sizeof(struct left), offsetof(struct right, v),
  > };
  > EOF
  $ cat > pair.c <<'EOF'
  > #include <stddef.h>
  > #include <stdio.h>
  > #include FIRST
  > #include SECOND
  > #include FIRST
  > #include SECOND
  > extern const size_t layout[4];
  > int main(void) {
  >   const size_t mine[] = {
  >     sizeof(((struct left *)0)->v),
  >     offsetof(struct left, v.cap) - offsetof(struct left, v),
  >     sizeof(struct left), offsetof(struct right, v),
  >   };
  >   int i;
  >   for (i = 0; i < 4; i++)
  >     if (mine[i] != layout[i])
  >       printf("layout %d: %zu, not %zu\n", i, mine[i], layout[i]);
  >   return 0;
  > }
  > EOF
  $ hostile="-Dvec__i=int -D__tc_arg__i=char -Dlink__i=int"
  $ typec -c layout.tc
  $ for cc in "$clang" "$gcc"; do
  >   for std in c11 gnu17; do
  >     for order in '"left.h" "right.h"' '"right.h" "left.h"'; do
  >       set -- $order
  >       "$cc" -std=$std $strict $hostile -DFIRST="$1" -DSECOND="$2" \
  >         pair.c layout.o -o pair && ./pair || echo "failed: $cc $std"
  >     done
  >   done
  > done

Under --trap-function, a header whose lowered text traps declares
__tc_trap in front of its text and defines it at its end under a guard
named for the trap function (design 9.3, 10.5). Two headers of one trap
function are included together, and the first defines it; two of
different trap functions fail to compile together. With the builtin
trap, a header declares nothing of it.

  $ cat > coin.tci <<'EOF'
  > #ifndef COIN_TCI
  > #define COIN_TCI
  > type coin = | Heads(int n) | Tails(int n);
  > static inline int coin_value(coin c) {
  >   match (c) {
  >   case Heads(n):
  >     return n;
  >   case Tails(n):
  >     return -n;
  >   }
  > }
  > #endif
  > EOF
  $ cat > die.tci <<'EOF'
  > #ifndef DIE_TCI
  > #define DIE_TCI
  > type die = | One(int n) | Two(int n);
  > static inline int die_value(die d) {
  >   match (d) {
  >   case One(n):
  >     return n;
  >   case Two(n):
  >     return 2 * n;
  >   }
  > }
  > #endif
  > EOF
  $ typec --emit-c-header -o plain.h coin.tci
  $ grep -c __tc_trap plain.h
  0
  [1]
  $ typec --trap-function=stop --emit-c-header coin.tci
  $ typec --trap-function=stop --emit-c-header die.tci
  $ grep '__tc_trap' coin.h
  #pragma push_macro("__tc_trap")
  #undef __tc_trap
  static inline _Noreturn void __tc_trap ( void ) ;
  return n ; } __tc_trap ( ) ; }
  return - n ; } __tc_trap ( ) ; }
  default : __tc_trap ( ) ; } }
  #ifndef __tc_trap__stop
  #define __tc_trap__stop
  static inline _Noreturn void __tc_trap ( void ) { _Noreturn void stop ( void ) ; stop ( ) ; __builtin_trap ( ) ; }
  #pragma pop_macro("__tc_trap")
  $ cat > toss.c <<'EOF'
  > #include <stdio.h>
  > #include <stdlib.h>
  > #include "coin.h"
  > #include "die.h"
  > _Noreturn void stop(void) { exit(3); }
  > int main(void) {
  >   coin c = { .tag = coin_Tails, .u.Tails.n = 2 };
  >   die d = { .tag = die_Two, .u.Two.n = 3 };
  >   printf("%d\n", coin_value(c) + die_value(d));
  >   return 0;
  > }
  > EOF
  $ for cc in "$clang" "$gcc"; do
  >   for std in c11 gnu17; do
  >     "$cc" -std=$std $strict toss.c -o toss && ./toss ||
  >       echo "failed: $cc $std"
  >   done
  > done
  4
  4
  4
  4
  $ typec --trap-function=halt --emit-c-header die.tci
  $ for cc in "$clang" "$gcc"; do
  >   "$cc" -std=c11 $strict -c toss.c -o toss.o 2>&1 |
  >     grep -c 'redefinition of .__tc_trap'
  > done
  1
  1

A header whose interface includes another declares the trap in front of
its own text, after the edits of the included text.

  $ cat > flip.tci <<'EOF'
  > #include "coin.tci"
  > static inline int flip_value(coin c) {
  >   match (c) {
  >   case Heads(n):
  >     return -n;
  >   case Tails(n):
  >     return n;
  >   }
  > }
  > EOF
  $ typec --trap-function=stop --emit-c-header flip.tci
  $ cat > flip.c <<'EOF'
  > #include <stdio.h>
  > #include <stdlib.h>
  > #include "flip.h"
  > _Noreturn void stop(void) { exit(3); }
  > int main(void) {
  >   coin c = { .tag = coin_Tails, .u.Tails.n = 2 };
  >   printf("%d\n", coin_value(c) + flip_value(c));
  >   return 0;
  > }
  > EOF
  $ "$clang" -std=c11 $strict flip.c -o flip && ./flip
  0
