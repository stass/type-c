; The fuzz harness. fuzz.sh builds the harness alias with an
; AFL-instrumented compiler; the normal build compiles it too, and
; seeds.t runs it on the seeds and on the source budget_probe prints.

(executable
 (name fuzz)
 (modules :standard \ dictionary budget_probe)
 (libraries
  unix
  typec_cpp
  typec_syntax
  typec_sema
  typec_emit
  typec_driver
  typec_test_support))

(executable
 (name dictionary)
 (modules dictionary)
 (libraries typec_cpp typec_syntax))

(executable
 (name budget_probe)
 (modules budget_probe)
 (libraries typec_test_support))

(rule
 (with-stdout-to
  fuzz.dict
  (run ./dictionary.exe)))

; What a campaign runs, in the build directory.

(alias
 (name harness)
 (deps fuzz.exe fuzz.dict))

(cram
 (deps fuzz.exe budget_probe.exe (source_tree seeds)))
