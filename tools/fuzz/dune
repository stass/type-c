; The fuzz harness. fuzz.sh builds it with an AFL-instrumented compiler;
; the normal build compiles it too, and seeds.t runs it on the seeds.

(executable
 (name fuzz)
 (libraries unix typec_cpp typec_emit typec_test_support))

(cram
 (deps fuzz.exe (source_tree seeds)))
