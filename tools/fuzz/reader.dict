# AFL++ dictionary for the reader target: the pieces of cc -E output
# that byte mutations rarely assemble on their own.

marker="# 1 \""
marker_enter="\" 1\x0a"
marker_return="\" 2\x0a"
marker_system="\" 1 3 4\x0a"
line="#line "
pragma="#pragma "
pragma_typec="#pragma typec "
pragma_system="#pragma GCC system_header\x0a"
newline="\x0a"
crlf="\x0d\x0a"
prefix_utf8="u8\""
prefix_char16="u'"
prefix_char32="U'"
prefix_wide="L\""
escape_hex="\\x"
escape_ucn4="\\u00"
escape_ucn8="\\U0001"
hex="0x"
binary="0b"
exponent="e+"
hex_exponent="p-"
suffix="ULL"
ellipsis="..."
shift_assign="<<="
digraph_hash="%:"
digraph_paste="%:%:"
paste="##"
arrow="->"
