/* A tree walk over a variant by match; tree.c is its hand-written twin.
   Usage: tree LEAVES ROUNDS SEED. */

#include <stdio.h>
#include <stdlib.h>

type expr =
    | Number(unsigned long value)
    | Add(const expr *left, const expr *right)
    | Subtract(const expr *left, const expr *right)
    | Multiply(const expr *left, const expr *right);

static unsigned long eval(const expr *e) {
  match (*e) {
  case Number(n): return n;
  case Add(l, r): return eval(l) + eval(r);
  case Subtract(l, r): return eval(l) - eval(r);
  case Multiply(l, r): return eval(l) * eval(r);
  }
}

/* The linear congruential step of Knuth's MMIX: a fixed, portable stream
   so that both twins build the same tree. */
static unsigned long next_random(unsigned long *state) {
  *state = *state * 6364136223846793005UL + 1442695040888963407UL;
  return *state >> 33;
}

/* A complete binary tree in heap order: node i has children 2i+1 and
   2i+2, and the last LEAVES nodes are the leaves. */
static void build(expr *nodes, unsigned long leaves, unsigned long seed) {
  unsigned long internal = leaves - 1;
  for (unsigned long i = internal; i < internal + leaves; i++)
    nodes[i] = Number(next_random(&seed));
  for (unsigned long i = internal; i-- > 0;) {
    const expr *l = &nodes[2 * i + 1], *r = &nodes[2 * i + 2];
    switch (next_random(&seed) % 3) {
    case 0: nodes[i] = Add(l, r); break;
    case 1: nodes[i] = Subtract(l, r); break;
    default: nodes[i] = Multiply(l, r); break;
    }
  }
}

int main(int argc, char **argv) {
  if (argc != 4)
    return 2;
  unsigned long leaves = strtoul(argv[1], NULL, 0);
  unsigned long rounds = strtoul(argv[2], NULL, 0);
  unsigned long seed = strtoul(argv[3], NULL, 0);
  if (leaves == 0)
    return 2;
  unsigned long internal = leaves - 1;
  expr *nodes = malloc((internal + leaves) * sizeof *nodes);
  if (nodes == NULL)
    return 1;
  build(nodes, leaves, seed);
  unsigned long sum = 0;
  /* Rewriting one leaf per round keeps the walk inside the loop. */
  for (unsigned long round = 0; round < rounds; round++) {
    nodes[internal + round % leaves] = Number(round);
    sum += eval(&nodes[0]);
  }
  printf("%lu\n", sum);
  free(nodes);
  return 0;
}
