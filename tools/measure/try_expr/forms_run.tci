/*
 * The loop that both forms.tc and forms_decl.tc run each form in:
 * RUN(X) defines run_X, which calls form_X for each value and sums the
 * values and the negated errors.  The loop is the same for the two, so
 * that their difference is that of the forms.
 */

#ifndef FORMS_RUN_TCI
#define	FORMS_RUN_TCI

#define	RUN(X)								\
long									\
run_##X(const int *v, long n)						\
{									\
	long sum;							\
	long i;								\
									\
	sum = 0;							\
	for (i = 0; i < n; i++) {					\
		match (form_##X(v[i])) {				\
		case Ok(r):						\
			sum += r;					\
			break;						\
		case Err(e):						\
			sum -= e;					\
			break;						\
		}							\
	}								\
	return (sum);							\
}

#endif /* !FORMS_RUN_TCI */
