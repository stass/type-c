/*
 * A match with patterns through pointers, three nodes deep: eight arms
 * that call a function, over overlapping labels.  fold.c is the C twin.
 */

#include "nested.tci"

long
fold(const expr *e)
{

	match (*e) {
	case Add(*Num(a), *Num(b)):
		return (arm(1, a, b));
	case Mul(*Num(a), *Num(b)):
		return (arm(2, a, b));
	case Add(*Num(a), _):
		return (arm(3, a, 0));
	case Add(_, *Num(b)):
		return (arm(4, 0, b));
	case Mul(_, *Num(b)):
		return (arm(5, 0, b));
	case Neg(*Neg(_)):
		return (arm(6, 0, 0));
	case Num(v):
		return (arm(7, v, 0));
	default:
		return (arm(8, 0, 0));
	}
}
