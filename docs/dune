; The catalogue of diagnostics is a build output of the one table of
; rules. dune build makes it, and dune test does too, so that a test run
; shows the catalogue still builds.

(rule
 (with-stdout-to
  diagnostics.md
  (run %{exe:../src/syntax/rule_table/rule_table.exe} catalogue)))

(rule
 (alias runtest)
 (deps diagnostics.md)
 (action
  (progn)))

; Every rule that the documents for users cite as [name] in prose is a
; live rule of the table (Rule_codegen.stale_citations). The documents
; here include the catalogue that the rule above makes.

(rule
 (alias runtest)
 (deps
  ../README.md
  (glob_files *.md)
  (glob_files_rec ../examples/README.md))
 (action
  (chdir
   %{workspace_root}
   (run %{exe:../src/syntax/rule_table/rule_table.exe} citations %{deps}))))

; The manual page; test/unit/test_manual.ml checks its lists of options
; and exit statuses against the driver's.

(install
 (section man)
 (package typec)
 (files typec.1))
